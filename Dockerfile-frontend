FROM nginx:alpine

# Instala curl para permitir healthcheck e proxy de teste de conexão
RUN apk add --no-cache curl

# Remove as páginas padrão da imagem do Nginx
RUN rm -rf /usr/share/nginx/html/*

# Copia as telas estáticas da pasta view para o Nginx
COPY src/main/resources/view /usr/share/nginx/html

# Copia a configuração personalizada do Nginx para o contêiner
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

# Healthcheck do Front-end Nginx a cada 30 segundos
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD curl -fsS http://localhost:80/ > /dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
