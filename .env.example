# Copie este arquivo para .env e preencha com as suas credenciais reais (o arquivo .env é ignorado pelo Git)
DOCKERHUB_USERNAME=seu_usuario_dockerhub
IMAGE_TAG=latest

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gearrent_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=sua_senha_do_banco
JWT_SECRET=sua_chave_secreta_jwt_com_mais_de_32_caracteres

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_REMETENTE=
EMAIL_ENVIO_HABILITADO=false

UPTIMEROBOT_HABILITADO=true
UPTIMEROBOT_INTERVALO_MS=30000
UPTIMEROBOT_ATRASO_INICIAL_MS=5000
UPTIMEROBOT_PING_URL=https://gearrent-eo3x.onrender.com/api/health
